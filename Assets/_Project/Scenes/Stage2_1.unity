  m_Script: {fileID: 11500000, guid: c951dff1e2696a54a95aa92eeaffa407, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.Runtime::Game.Cutscene.PhoneCall
  lines:
  - speaker: "\uC18C\uC7A5"
    text: "\u2026\uC5F0\uACB0\uB410\uAD70. \uC790\uB124, \uBB34\uC0AC\uD55C\uAC00."
    seconds: 2.5
  - speaker: "\uC18C\uC7A5"
    text: "\uC0C1\uD669\uC740 \uD1B5\uC81C\uD558\uC5D0 \uC788\uB124. \uC678\uBD80\uC5D0\uB294 \uC774\uBBF8 \uC5F0\uB77D\uD574 \uB450\uC5C8\uC5B4."
    seconds: 3.5
  - speaker: "\uC18C\uC7A5"
    text: "\uCD5C\uD558\uCE35\uC73C\uB85C \uC9D1\uACB0\uD558\uAC8C. \uC720\uC0AC\uC2DC\uC5D0\uB294 \uC9C0\uD558\uD130\uB110\uB85C \uD1F4\uAC01\uD574 \uB300\uD53C\uD558\uACE0 \uD56D\uC804\uD558\uB3C4\uB85D."
    seconds: 4
  - speaker: "\uC18C\uC7A5"
    text: "\uC0C1\uD669\uC740 \uD1B5\uC81C\uD558\uC5D0 \uC788\uB124."
    seconds: 2.5
  - speaker: "\uC18C\uC7A5"
    text: "\uC0C1\uD669\uC740 \uD1B5\uC81C\uD558\uC5D0 \uC788\uB124\u2026  \uC0C1\uD669\uC740 \uD1B5\uC81C\uD558\uC5D0 \uC788\uB124\u2026"
    seconds: 3
  startDelaySeconds: 0.6
  triggerRadius: 0
  goalAfter: {fileID: 0}
